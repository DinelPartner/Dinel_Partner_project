# Resend (transactional email) API key — used by src/pages/api/kontakt.ts,
# src/pages/api/offert.ts and src/pages/api/offert-klimat.ts.
# Get one at https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here

# Google reCAPTCHA v2 secret key (server-side verification for the contact
# form only — the two quote forms never had reCAPTCHA, matching old behavior).
# Get it at https://www.google.com/recaptcha/admin
RECAPTCHA_SECRET_KEY=your_recaptcha_v2_secret_key_here

# GitHub OAuth App credentials for the Sveltia/Decap CMS "github" backend
# login flow (public/admin). Create the OAuth App at
# https://github.com/settings/developers — homepage URL and callback URL
# should both point at your Vercel production domain, with the callback
# being <your-domain>/api/callback.
GITHUB_OAUTH_CLIENT_ID=your_github_oauth_client_id_here
GITHUB_OAUTH_CLIENT_SECRET=your_github_oauth_client_secret_here
