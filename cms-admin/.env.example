# GitHub Contents API access — server-side only, never exposed to the browser,
# never prefixed PUBLIC_. Create a fine-grained Personal Access Token scoped to
# ONLY this one repository, with "Contents: Read and write" permission (see
# cms-admin/README.md for the exact steps).
GITHUB_TOKEN=github_pat_xxx
GITHUB_OWNER=your-github-username-or-org
GITHUB_REPO=DINEL_PARTNER
GITHUB_BRANCH=main

# Initial admin password for the panel's single login form (no user accounts).
# After the first change in the panel, the password is stored as a server-side
# hash in content/.cms-admin-password and this value is only the fallback.
ADMIN_PASSWORD=change-me-to-something-long-and-random

# Secret used to HMAC-sign the session cookie. Any long random string;
# generate one with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-hex-string

# Optional extra origin allowed to call the public /api/posts endpoints
# (besides https://www.dinelpartner.se and https://dinelpartner.se, which are
# always allowed). Useful for a staging domain.
ALLOWED_ORIGIN=
