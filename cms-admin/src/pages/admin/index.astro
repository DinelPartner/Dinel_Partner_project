---
export const prerender = false;
import '../../styles/admin.css';
import { requireAuth } from '../../lib/session';

if (!requireAuth(Astro.request)) {
  return Astro.redirect('/');
}
---
<!doctype html>
<html lang="sv">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Inlägg – Din Elpartner CMS</title>
  </head>
  <body>
    <div class="topbar">
      <div class="brand">Din Elpartner <span>CMS</span></div>
      <nav style="display:flex; gap:.5rem;">
        <a href="/admin/edit">+ Nytt inlägg</a>
        <button id="logout-btn">Logga ut</button>
      </nav>
    </div>
    <div class="wrap">
      <div class="page-heading">
        <div>
          <p class="eyebrow">DIN ELPARTNER CMS</p>
          <h1>Alla inlägg</h1>
          <p class="page-intro">Hantera publicerade artiklar och utkast från ett ställe.</p>
        </div>
        <a class="btn" href="/admin/edit">+ Nytt inlägg</a>
      </div>
      <div class="card card-list">
        <div id="list-loading">Laddar…</div>
        <div id="list-error" class="error-text" hidden></div>
        <div id="post-list" class="post-grid"></div>
      </div>

      <h2>Bezpieczeństwo</h2>
      <form id="password-form" class="card">
        <div class="field">
          <label for="current-password">Obecne hasło</label>
          <input type="password" id="current-password" required autocomplete="current-password" />
        </div>
        <div class="grid-2">
          <div class="field">
            <label for="new-password">Nowe hasło</label>
            <input type="password" id="new-password" required minlength="8" autocomplete="new-password" />
          </div>
          <div class="field">
            <label for="confirm-password">Powtórz nowe hasło</label>
            <input type="password" id="confirm-password" required minlength="8" autocomplete="new-password" />
          </div>
        </div>
        <button class="btn" type="submit" id="password-btn">Zmień hasło</button>
        <span id="password-status" style="margin-left:.75rem; font-size:.85rem;"></span>
      </form>
    </div>

    <script>
      const listEl = document.getElementById('post-list');
      const loadingEl = document.getElementById('list-loading');
      const errorEl = document.getElementById('list-error');

      function escapeHtml(str) {
        return String(str).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
      }

      function resolveImageUrl(path) {
        if (!path) return '';
        if (/^https?:\/\//i.test(path)) return path;
        return `https://www.dinelpartner.se${path.startsWith('/') ? '' : '/'}${path}`;
      }

      async function loadPosts() {
        loadingEl.hidden = false;
        errorEl.hidden = true;
        listEl.innerHTML = '';
        try {
          const res = await fetch('/api/admin/posts', { credentials: 'include' });
          if (res.status === 401) {
            window.location.href = '/';
            return;
          }
          if (!res.ok) throw new Error('Kunde inte hämta inlägg');
          const posts = await res.json();
          loadingEl.hidden = true;
          if (posts.length === 0) {
            listEl.innerHTML = '<p class="empty-state">Inga inlägg ännu. Skapa ditt första inlägg.</p>';
            return;
          }
          for (const post of posts) {
            const row = document.createElement('div');
            row.className = 'post-card';
            const title = post.sv ? post.sv.title : post.en ? post.en.title : post.slug;
            const category = post.sv ? post.sv.category : post.en ? post.en.category : 'Artikel';
            const excerpt = post.sv ? post.sv.excerpt : post.en ? post.en.excerpt : '';
            row.innerHTML = `
              <div class="post-card-image">
                <img src="${escapeHtml(resolveImageUrl(post.image))}" alt="" loading="lazy" onerror="this.parentElement.classList.add('image-missing'); this.remove()" />
                <span class="badge ${post.published ? 'published' : 'draft'}">${post.published ? 'Publicerad' : 'Utkast'}</span>
              </div>
              <div class="post-card-body">
                <div class="post-card-meta"><span>${escapeHtml(category)}</span><time>${escapeHtml(post.date)}</time></div>
                <h2>${escapeHtml(title)}</h2>
                <p>${escapeHtml(excerpt)}</p>
                <div class="post-actions">
                  <a class="btn btn-secondary" href="/admin/edit?slug=${encodeURIComponent(post.slug)}">Redigera</a>
                  <button class="btn-danger" data-slug="${escapeHtml(post.slug)}" data-title="${escapeHtml(title)}">Ta bort</button>
                </div>
              </div>
            `;
            listEl.appendChild(row);
          }
          listEl.querySelectorAll('button.btn-danger').forEach((btn) => {
            btn.addEventListener('click', async () => {
              const slug = btn.getAttribute('data-slug');
              const title = btn.getAttribute('data-title');
              if (!confirm(`Ta bort inlägget "${title}"? Detta går inte att ångra.`)) return;
              btn.disabled = true;
              btn.textContent = 'Tar bort…';
              try {
                const res = await fetch(`/api/admin/posts/${encodeURIComponent(slug)}`, {
                  method: 'DELETE',
                  credentials: 'include',
                });
                if (!res.ok) {
                  const data = await res.json().catch(() => ({}));
                  alert(data.error || 'Kunde inte ta bort inlägget');
                  btn.disabled = false;
                  btn.textContent = 'Ta bort';
                  return;
                }
                loadPosts();
              } catch {
                alert('Nätverksfel, försök igen.');
                btn.disabled = false;
                btn.textContent = 'Ta bort';
              }
            });
          });
        } catch (err) {
          loadingEl.hidden = true;
          errorEl.hidden = false;
          errorEl.textContent = err instanceof Error ? err.message : 'Okänt fel';
        }
      }

      document.getElementById('logout-btn').addEventListener('click', async () => {
        await fetch('/api/logout', { method: 'POST', credentials: 'include' });
        window.location.href = '/';
      });

      document.getElementById('password-form').addEventListener('submit', async (event) => {
        event.preventDefault();
        const btn = document.getElementById('password-btn');
        const status = document.getElementById('password-status');
        btn.disabled = true;
        status.textContent = 'Zapisywanie…';
        status.className = '';

        try {
          const res = await fetch('/api/admin/password', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'include',
            body: JSON.stringify({
              currentPassword: document.getElementById('current-password').value,
              newPassword: document.getElementById('new-password').value,
              confirmPassword: document.getElementById('confirm-password').value,
            }),
          });
          const data = await res.json().catch(() => ({}));
          if (!res.ok) throw new Error(data.error || 'Nie udało się zmienić hasła');
          status.textContent = 'Hasło zmienione.';
          status.className = 'success-text';
          document.getElementById('password-form').reset();
        } catch (error) {
          status.textContent = error instanceof Error ? error.message : 'Nie udało się zmienić hasła';
          status.className = 'error-text';
        } finally {
          btn.disabled = false;
        }
      });

      loadPosts();
    </script>
  </body>
</html>
